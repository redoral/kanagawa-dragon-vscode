  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#737c73",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff headers / ranges",
      "scope": ["meta.diff", "meta.diff.header"],
      "settings": {
        "foreground": "#c5c9c5"
      }
    },
    {
      "name": "Diff inserted / deleted / changed",
      "scope": ["markup.inserted", "punctuation.definition.inserted"],
      "settings": {
        "foreground": "#76946A"
      }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "punctuation.definition.deleted"],
      "settings": {
        "foreground": "#C34043"
      }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": {
        "foreground": "#c4b28a"
      }
    },
    {
      "name": "Markup quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#c5c9c5"
      }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup bold-italic",
      "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
      "settings": {
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markup strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline",
        "string.other.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#949fb5",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading",
        "punctuation.definition.section"
      ],
      "settings": {
        "foreground": "#8ba4b0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup inline code / raw",
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "punctuation.definition.raw"
      ],
      "settings": {
        "foreground": "#8a9a7b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup list markers",
      "scope": ["punctuation.definition.list_item"],
      "settings": {
        "foreground": "#c5c9c5"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.regexp",
        "string.regexp.replace"
      ],
      "settings": {
        "foreground": "#c4746e"
      }
    },
    {
      "name": "Escape sequences / placeholders",
      "scope": [
        "constant.character.escape",
        "string.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#c4746e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "punctuation.definition.character"
      ],
      "settings": {
        "foreground": "#8a9a7b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String interpolation markers",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.definition.interpolation",
        "punctuation.section.embedded",
        "punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#949fb5"
      }
    },
    {
      "name": "JSON object keys",
      "scope": ["string.json"],
      "settings": {
        "foreground": "#c4b28a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON object values",
      "scope": ["string.value.json"],
      "settings": {
        "foreground": "#8a9a7b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#a292a3"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant", "support.constant", "entity.name.constant"],
      "settings": {
        "foreground": "#b6927b"
      }
    },
    {
      "name": "Booleans",
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#b6927b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Language variables (this, self, super)",
      "scope": ["variable.language", "variable.language.special"],
      "settings": {
        "foreground": "#c4746e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#c5c9c5"
      }
    },
    {
      "name": "Object properties / members / keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#c4b28a"
      }
    },
    {
      "name": "Constant variables (SCREAMING_CASE, const)",
      "scope": ["variable.other.constant", "variable.other.enummember"],
      "settings": {
        "foreground": "#b6927b"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable.other", "variable"],
      "settings": {
        "foreground": "#c5c9c5"
      }
    },
    {
      "name": "Control flow (TS/JS return/throw/yield)",
      "scope": [
        "keyword.control.flow.ts",
        "keyword.control.flow.js",
        "keyword.control.flow.jsx",
        "keyword.control.flow.tsx",
        "keyword.control.flow.javascript",
        "keyword.control.flow.typescript"
      ],
      "settings": {
        "foreground": "#c4746e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow keywords (if, else, for, while...)",
      "scope": ["keyword.control"],
      "settings": {
        "foreground": "#8992a7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Exception keywords (try, catch, throw, raise)",
      "scope": ["keyword.control.exception"],
      "settings": {
        "foreground": "#c4746e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Import / export / include keywords",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.include",
        "keyword.control.at-include",
        "keyword.other.import",
        "keyword.other.use",
        "keyword.other.package",
        "keyword.import",
        "keyword.package"
      ],
      "settings": {
        "foreground": "#c4746e"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#c4746e"
      }
    },
    {
      "name": "Word operators (and, or, in, instanceof...)",
      "scope": [
        "keyword.operator.logical.word",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.relational"
      ],
      "settings": {
        "foreground": "#c4746e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "`new` keyword",
      "scope": ["keyword.operator.new"],
      "settings": {
        "foreground": "#8992a7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Storage types & modifiers (const, static, public...)",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#8992a7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Preprocessor / directives",
      "scope": [
        "keyword.directive",
        "meta.preprocessor",
        "punctuation.definition.preprocessor",
        "meta.preprocessor.string",
        "meta.preprocessor.numeric",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#c4746e"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8ba4b0"
      }
    },
    {
      "name": "Builtin / magic functions",
      "scope": ["support.function.builtin", "support.function.magic"],
      "settings": {
        "foreground": "#949fb5"
      }
    },
    {
      "name": "Decorators / annotations",
      "scope": [
        "meta.function.decorator",
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "meta.annotation",
        "entity.name.annotation"
      ],
      "settings": {
        "foreground": "#b6927b"
      }
    },
    {
      "name": "Rust attributes",
      "scope": [
        "meta.attribute.rust",
        "entity.name.attribute.rust",
        "entity.name.attribute"
      ],
      "settings": {
        "foreground": "#c4746e"
      }
    },
    {
      "name": "Types / classes / namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#8ea4a2"
      }
    },
    {
      "name": "HTML/XML tags",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#8ea4a2"
      }
    },
    {
      "name": "HTML/XML attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#c4b28a"
      }
    },
    {
      "name": "Tag delimiters",
      "scope": ["punctuation.definition.tag"],
      "settings": {
        "foreground": "#c5c9c5"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#c5c9c5"
      }
    },
    {
      "name": "Invalid / illegal",
      "scope": ["invalid"],
      "settings": {
        "foreground": "#c4746e",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#717C7C",
        "fontStyle": "strikethrough"
      }
    }
  ],

  "semanticTokenColors": {
    "namespace": "#8ea4a2",
    "class": "#8ea4a2",
    "interface": "#8ea4a2",
    "struct": "#8ea4a2",
    "enum": "#8ea4a2",
    "enumMember": "#b6927b",
    "type": "#8ea4a2",
    "typeParameter": "#8ea4a2",
    "function": "#8ba4b0",
    "method": "#8ba4b0",
    "macro": "#c4746e",
    "parameter": "#c5c9c5",
    "property": "#c4b28a",
    "variable": "#c5c9c5",
    "decorator": "#b6927b",
    "event": "#c4746e",
    "operator": "#c4746e",
    "keyword": "#8992a7",
    "comment": "#737c73",
    "string": "#8a9a7b",
    "number": "#a292a3",
    "regexp": "#c4746e",
    "label": "#c4b28a",

    "variable.readonly": "#b6927b",
    "variable.global": "#b6927b",
    "variable.static": "#b6927b",
    "property.readonly": "#b6927b",
    "variable.defaultLibrary": "#949fb5",
    "function.defaultLibrary": "#949fb5",
    "method.defaultLibrary": "#949fb5",
    "function.builtin": "#949fb5",
    "class.defaultLibrary": "#949fb5",
    "interface.defaultLibrary": "#949fb5",
    "type.defaultLibrary": "#949fb5",
    "*.typeHint": "#8ea4a2",
    "*.deprecated": "#717C7C",
    "*.unused": "#717C7C"
  },

  "semanticTokenScopes": {
    "rust": {
      "decorator": ["meta.attribute.rust"],
      "macro": ["entity.name.macro.rust"]
    },
    "python": {
      "decorator": [
        "entity.name.function.decorator",
        "meta.function.decorator.python"
      ]
    }
  }
}
